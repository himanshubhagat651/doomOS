# ==============================================================================
# DoomOS Calamares Branding Descriptor
# ==============================================================================
---
componentName: "doomos"
welcomeStyleCalamares: true
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 960px, 600px

strings:
    productName: "DoomOS"
    shortProductName: "DoomOS"
    version: "1.0.0 Rolling"
    shortVersion: "1.0"
    versionedName: "DoomOS 1.0 (KDE Plasma Edition)"
    shortVersionedName: "DoomOS 1.0"
    bootloaderEntryName: "DoomOS"
    productUrl: "https://doomos.org"
    supportUrl: "https://doomos.org/support"
    bugReportUrl: "https://github.com/doomos-project/doomos/issues"

images:
    productLogo: "logo.png"
    productIcon: "logo.png"
    productWelcome: "welcome.png"

style:
    SidebarBackground: "#0f172a"
    SidebarText: "#f8fafc"
    SidebarTextHighlight: "#0284c7"
    SidebarSelect: "#1e293b"
    SidebarIconSize: 24px

slideshow:
    - "slide1.html"
    - "slide2.html"

slideshowAPI: 2
