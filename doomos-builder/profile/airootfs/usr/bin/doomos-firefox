#!/usr/bin/env bash
# ==============================================================================
# DoomOS Smart Environment-Aware Firefox Launcher (/usr/bin/doomos-firefox)
# ==============================================================================
# Diagnoses the host runtime:
#  - On Physical Hardware (Apple Silicon bare-metal, AMD/Intel PC):
#      Launches native Wayland Firefox with full hardware GPU acceleration.
#  - Inside Virtual Machines (VMware Fusion / Workstation SVGA3D, VirtIO, QEMU):
#      Applies targeted environment variables to eliminate EGL / svga3d crashes
#      without disabling Wayland globally or altering other KDE applications.
# ==============================================================================

set -eo pipefail

IS_VM=0

# 1. Hypervisor / VM Detection via systemd-detect-virt
if command -v systemd-detect-virt >/dev/null 2>&1; then
    VIRT_TYPE=$(systemd-detect-virt 2>/dev/null || echo "none")
    if [[ "${VIRT_TYPE}" != "none" ]]; then
        IS_VM=1
    fi
fi

# 2. Kernel DMI / Chassis / Sysfs Detection
if [[ "${IS_VM}" -eq 0 ]]; then
    SYS_VENDOR=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || echo "")
    PRODUCT_NAME=$(cat /sys/class/dmi/id/product_name 2>/dev/null || echo "")
    if echo "${SYS_VENDOR} ${PRODUCT_NAME}" | grep -Eiq "vmware|qemu|kvm|virtualbox|bochs"; then
        IS_VM=1
    fi
fi

# 3. Graphics Driver & DRM Bus Inspection
if [[ "${IS_VM}" -eq 0 ]]; then
    if lsmod 2>/dev/null | grep -Eiq "vmwgfx|virtio_gpu"; then
        IS_VM=1
    fi
fi

# 4. Locate the Real Firefox Binary (Native package or Flatpak sandbox)
REAL_FIREFOX=""
if [[ -x "/usr/lib/firefox/firefox" ]]; then
    REAL_FIREFOX="/usr/lib/firefox/firefox"
elif [[ -x "/usr/bin/firefox" && "$(realpath /usr/bin/firefox 2>/dev/null)" != "$(realpath "$0" 2>/dev/null)" ]]; then
    REAL_FIREFOX="/usr/bin/firefox"
fi

# 5. Execute with Targeted Environment Profile
if [[ "${IS_VM}" -eq 1 ]]; then
    # Virtual Machine Profile:
    # Use XWayland backend for Firefox windowing to prevent Mesa svga3d buffer sync panic
    export MOZ_ENABLE_WAYLAND=0
    export MOZ_DISABLE_RDD_SANDBOX=1
    export LIBGL_ALWAYS_SOFTWARE=0
    
    # If Flatpak Firefox is invoked or running
    if [[ -z "${REAL_FIREFOX}" ]] && command -v flatpak >/dev/null 2>&1; then
        if flatpak info org.mozilla.firefox >/dev/null 2>&1; then
            exec flatpak run --env=MOZ_ENABLE_WAYLAND=0 org.mozilla.firefox "$@"
        fi
    fi
else
    # Physical Bare-Metal Profile (Apple Silicon / Bare Metal PCs):
    # Pure native Wayland with VAAPI / DMABUF hardware pipeline intact
    export MOZ_ENABLE_WAYLAND=1
fi

if [[ -n "${REAL_FIREFOX}" && -x "${REAL_FIREFOX}" ]]; then
    exec "${REAL_FIREFOX}" "$@"
elif command -v flatpak >/dev/null 2>&1 && flatpak info org.mozilla.firefox >/dev/null 2>&1; then
    exec flatpak run org.mozilla.firefox "$@"
else
    echo "[DoomOS Launcher] Error: Firefox binary not found." >&2
    exit 1
fi
