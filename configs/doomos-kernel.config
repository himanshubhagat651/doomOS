# ==============================================================================
# DoomOS Linux Kernel Architectural Configuration Reference (v1.0.0)
# Target Architecture: x86_64
# Target Firmware:     UEFI 64-bit
# Target Virtualization: VMware Workstation / Fusion (SVGA3D + vmxnet3)
# ==============================================================================

# 1. Target CPU Architecture & Basic Processor Features
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86=y
CONFIG_GENERIC_CPU=y
CONFIG_SMP=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y

# 2. UEFI Firmware & EFI Boot Protocol
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=n
CONFIG_FB_EFI=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_EFI_PARTITION=y

# 3. VMware Virtualization Drivers (Guest Support)
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_VMWGFX_FBCON=y
CONFIG_VMWARE_BALLOON=m
CONFIG_VMWARE_VMCI=m
CONFIG_VMWARE_VMCI_VSOCKETS=m
CONFIG_VMXNET3=m
CONFIG_FUSION=y
CONFIG_FUSION_SPI=m
CONFIG_SCSI_MPT2SAS=m
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y

# 4. Storage Controllers & Bus Subsystems
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_PCI=m

# 5. Core Filesystems & Live Media Layering
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y

# 6. Memory & Security Tuning
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
